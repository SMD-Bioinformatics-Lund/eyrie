# Eyrie Environment Configuration - Development
# This file configures the application for local development

# =====================================================
# Version Management
# =====================================================
EYRIE_VERSION=latest
POPUP_VERSION=latest
FRONTEND_VERSION=${EYRIE_VERSION}
BACKEND_VERSION=${EYRIE_VERSION}
MONGODB_VERSION=5.0.32

# =====================================================
# Host Ports (local development)
# =====================================================
FRONTEND_HOST_PORT=3000
BACKEND_HOST_PORT=8000
MONGO_HOST_PORT=27017

# =====================================================
# External URLs (local development)
# =====================================================
EXTERNAL_BASE_PATH=
EXTERNAL_API_URL=http://localhost:${BACKEND_HOST_PORT}/api

# =====================================================
# Internal URLs (container-to-container communication)
# =====================================================
INTERNAL_BACKEND_URL=http://eyrie_backend:5000
BACKEND_BASE_PATH=/api

# =====================================================
# Database Configuration
# =====================================================
MONGO_URI=mongodb://mongodb:27017/eyrie

# =====================================================
# Application Environment
# =====================================================
ENVIRONMENT=development

# =====================================================
# Optional: Logging and Debug
# =====================================================
LOG_LEVEL=DEBUG
DEBUG=true

# =====================================================
# Analysis Results Paths
# =====================================================
EYRIE_ANALYSIS_OUTPUT_DIRPATH=./analysis-files/results/trana
TRANA_ANALYSIS_RESULTS=/app/analysis-files/results/trana
METAVAL_ANALYSIS_RESULTS=/app/analysis-files/results/metaval

# =====================================================
# Security
# =====================================================
SECRET_KEY=dev-secret-key-change-in-production
JWT_SECRET=dev-jwt-secret-change-in-production
JWT_EXPIRATION_HOURS=24
JWT_COOKIE_SECURE=false
